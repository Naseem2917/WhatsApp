rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for search, chat display)
      allow read: if isAuthenticated();
      
      // Users can only create/update their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      // Users cannot delete profiles
      allow delete: if false;
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Only participants can read the chat
      allow read: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      
      // Any authenticated user can create a chat (they become a participant)
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants;
      
      // Only participants can update the chat
      allow update: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      
      // Only group admins can delete groups (or last participant leaving)
      allow delete: if isAuthenticated() && 
        (resource.data.isGroup == false || 
         request.auth.uid in resource.data.admins);
      
      // Messages subcollection
      match /messages/{messageId} {
        // Only chat participants can read messages
        allow read: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Only chat participants can send messages
        allow create: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        
        // Only message sender or chat participants can update (for read status)
        allow update: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Messages cannot be deleted
        allow delete: if false;
      }
    }
    
    // Scheduled messages collection (for AI feature)
    match /scheduledMessages/{messageId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid == resource.data.senderId;
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
    }
  }
}
